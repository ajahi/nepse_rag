# Copy to .env and fill in. The app boots even with these missing —
# any path that needs a missing piece will honestly say "I'm not sure".
# These names match app28.py in your Gemini-Pro project.

# LLM — Groq (router fallback, text2SQL, RAG + web-search answering)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings — Cohere (RAG knowledge base). Must match what built the index.
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0

# RAG index folder (built by build_index.py)
DEFAULT_INDEX=nepse_kb
RETRIEVAL_K=5

# --- Postgres (the Docker `db` service also reads these) ---
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse
POSTGRES_DB=nepse
# In Docker the host MUST be the compose service name `db`. Keep the user/pass/db
# below in sync with the three vars above.
PG_DSN=postgresql://nepse:nepse@db:5432/nepse
# Not using Docker? Point it at your own Postgres instead, e.g.:
# PG_DSN=postgresql://user:pass@localhost:5432/nepse

# Confidence below this triggers the "I'm not sure" hedge (0-1)
MIN_CONFIDENCE=0.45

# Web search uses keyless DuckDuckGo (ddgs) — no key needed.

# Optional: email alerts when verification blocks an answer (see notifier_26.py).
# Leave blank to disable email alerts (the notifier no-ops if unconfigured).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=            # Gmail App Password — NEVER commit the real value
ALERT_FROM=
ALERT_TO=
